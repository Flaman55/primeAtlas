__pycache__/
*.pyc

# Native sieve backends are built locally under WSL; source and build commands are tracked,
# never machine-specific ELF shared objects.
prime_sieve/*.so

# Per-install runtime state (storage path, theme, cudasieve/env-check status, etc.) --
# not source, diverges on every real machine, and was getting accidentally clobbered by
# test runs that didn't isolate it properly (see test_env_setup.py Section E).
primeatlas/core/locales/app_settings.json
primeatlas/core/locales/language_settings.json

# Generated prime windows, benchmark reports and per-run logs.  This is the
# local Atlas archive/output cache, never source code or a portable fixture.
CONSTELLATION_PORTAL/

# Working planning doc for the Ring visualization feature -- development-process
# notes, not source or a user-facing artifact; not meant to ship in the repo.
PLAN.md

# Inno Setup build output (installer/PrimeAtlasSetup.iss) -- published as a GitHub Release
# asset, never committed.
installer/Output/
installer/vendor/

# AI assistant instruction/config files -- local tooling, not project source.
CLAUDE.md
CLAUDE.local.md
.claude/
